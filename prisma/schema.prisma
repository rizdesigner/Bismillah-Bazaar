generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  customer
}

enum UserStatus {
  pending_approval
  active
  suspended
}

enum OrderStatus {
  pending
  modified
  confirmed
  delivered
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  overdue
}

enum PaymentMethod {
  etransfer
  cash
  check
  credit_card
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  email              String                  @unique
  password           String?
  role               UserRole                @default(customer)
  restaurantName     String?                 @map("restaurant_name")
  phone              String?
  location           String?
  status             UserStatus              @default(pending_approval)
  createdAt          DateTime                @default(now()) @map("created_at")
  orders             Order[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]
  customOverrides    ClientProductOverride[]
  conversations      Conversation[]

  @@map("users")
}

model Inventory {
  id              String                  @id @default(uuid()) @db.Uuid
  itemName        String                  @map("item_name")
  category        String
  basePriceKg     Decimal                 @db.Decimal(10, 2) @map("base_price_kg")
  imageUrl        String?                 @map("image_url")
  inStock         Boolean                 @default(true) @map("in_stock")
  createdAt       DateTime                @default(now()) @map("created_at")
  orderItems      OrderItem[]
  customOverrides ClientProductOverride[]
  pieceSizes      PieceSize[]

  @@map("inventory")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number")
  userId          String        @map("user_id") @db.Uuid
  originalTotal   Decimal       @db.Decimal(10, 2) @map("original_total")
  finalTotal      Decimal?      @db.Decimal(10, 2) @map("final_total")
  requestedEta    DateTime?     @map("requested_eta")
  adminEta        DateTime?     @map("admin_eta")
  deliveredAt     DateTime?     @map("delivered_at")
  dueDate         DateTime?     @map("due_date")
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")
  paymentMethod   PaymentMethod? @map("payment_method")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  notifications   Notification[]

  @@map("orders")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  itemId       String     @map("item_id") @db.Uuid
  pieceSizeId  String?    @map("piece_size_id") @db.Uuid
  requestedKg  Decimal    @db.Decimal(10, 2) @map("requested_kg")
  fulfilledKg  Decimal?   @db.Decimal(10, 2) @map("fulfilled_kg")
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item         Inventory  @relation(fields: [itemId], references: [id])
  pieceSize    PieceSize? @relation(fields: [pieceSizeId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Settings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ClientProductOverride {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  itemId        String    @map("item_id") @db.Uuid
  customPriceKg Decimal?  @db.Decimal(10, 2) @map("custom_price_kg")
  isAvailable   Boolean   @default(true) @map("is_available")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item          Inventory @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
  @@map("client_product_overrides")
}

model PieceSize {
  id         String     @id @default(uuid()) @db.Uuid
  itemId     String     @map("item_id") @db.Uuid
  sizeLabel  String     @map("size_label")
  sizeValue  Int        @map("size_value")
  sizeUnit   String     @default("grm") @map("size_unit")
  createdAt  DateTime   @default(now()) @map("created_at")
  item       Inventory  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([itemId])
  @@map("piece_sizes")
}

model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  adminUnreadCount   Int       @default(0) @map("admin_unread_count")
  customerUnreadCount Int      @default(0) @map("customer_unread_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  senderId        String       @map("sender_id") @db.Uuid
  senderRole      String       @map("sender_role")
  content         String
  readAt          DateTime?    @map("read_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
